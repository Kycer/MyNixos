set $mod Mod1
set $left h
set $down j
set $up k
set $right l
set $term footclient
set $menu fuzzel

font pango:JetBrainsMono Nerd Font 11
floating_modifier $mod normal
workspace_auto_back_and_forth yes
default_border pixel 2
gaps inner 4
gaps outer 2

# Cloudbox runs with WLR_BACKENDS=headless. This output is also captured by WayVNC.
output HEADLESS-1 {
    mode 1920x1080
    scale 1.25
}

# Waybar reads its native JSONC/CSS configuration directly from this repository.
exec_always --no-startup-id sh -c 'pkill -x waybar || true; exec waybar --config ~/.nixos/config/waybar/config.jsonc --style ~/.nixos/config/waybar/style.css'

# Export the live Wayland environment and start user services such as Foot and WayVNC.
exec_always --no-startup-id systemctl --user import-environment WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec_always --no-startup-id dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec_always --no-startup-id systemctl --user start sway-session.target

# Applications and session
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+x exec swaylock
bindsym $mod+Ctrl+Shift+r exec systemctl --user restart fcitx5
bindsym $mod+e exec $term -e yazi
bindsym $mod+Shift+e exec nautilus
bindsym $mod+w kill
bindsym $mod+Shift+q exec swaynag -t warning -m 'Exit Sway?' -B 'Exit' 'swaymsg exit'

# Audio and backlight
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym --locked XF86AudioMicMute exec wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
bindsym --locked XF86MonBrightnessUp exec brightnessctl set +5%
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-

# Focus and move containers
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right

bindsym $mod+Ctrl+$left focus output left
bindsym $mod+Ctrl+$down focus output down
bindsym $mod+Ctrl+$up focus output up
bindsym $mod+Ctrl+$right focus output right

bindsym $mod+Ctrl+Shift+$left move container to output left
bindsym $mod+Ctrl+Shift+$down move container to output down
bindsym $mod+Ctrl+Shift+$up move container to output up
bindsym $mod+Ctrl+Shift+$right move container to output right

bindsym $mod+Tab focus prev
bindsym $mod+Shift+Tab workspace back_and_forth

# Workspaces
bindsym $mod+n workspace next
bindsym $mod+p workspace prev
bindsym $mod+Ctrl+n move container to workspace next
bindsym $mod+Ctrl+p move container to workspace prev

bindsym --whole-window $mod+button5 workspace next
bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+Ctrl+button5 move container to workspace next
bindsym --whole-window $mod+Ctrl+button4 move container to workspace prev

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# Layout and sizing
bindsym $mod+t layout toggle tabbed split
bindsym $mod+f fullscreen toggle
bindsym $mod+space floating toggle
bindsym $mod+c focus mode_toggle
bindsym $mod+minus resize shrink width 10 ppt
bindsym $mod+equal resize grow width 10 ppt
bindsym $mod+Shift+minus resize shrink height 10 ppt
bindsym $mod+Shift+equal resize grow height 10 ppt
bindsym $mod+Ctrl+Shift+p output * power toggle

# Sway configuration
bindsym $mod+Shift+c reload

# Catppuccin Macchiato Lavender
client.focused          #c6a0f6 #c6a0f6 #24273a #c6a0f6 #c6a0f6
client.focused_inactive #363a4f #363a4f #cad3f5 #363a4f #363a4f
client.unfocused        #1e2030 #1e2030 #cad3f5 #1e2030 #1e2030
client.urgent           #ed8796 #ed8796 #24273a #ed8796 #ed8796

include /etc/sway/config.d/*
