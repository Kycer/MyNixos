{
  "layer": "top",
  "position": "top",
  "mode": "dock",
  "exclusive": true,
  "passthrough": false,
  "fixed-center": true,
  "reload_style_on_change": true,
  "height": 34,
  "spacing": 4,

  "modules-left": [
    "sway/workspaces",
    "sway/mode"
  ],
  "modules-center": [
    "sway/window"
  ],
  "modules-right": [
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "tray",
    "clock"
  ],

  "sway/workspaces": {
    "all-outputs": true,
    "disable-scroll": true,
    "disable-scroll-wraparound": true,
    "format": "{name}",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": [],
      "6": [],
      "7": [],
      "8": [],
      "9": []
    }
  },

  "sway/mode": {
    "format": "󰌌  {}",
    "tooltip": false
  },

  "sway/window": {
    "max-length": 70,
    "icon": true,
    "icon-size": 16
  },

  "pulseaudio": {
    "scroll-step": 5,
    "format": "{icon}  {volume}%",
    "format-bluetooth": "  {volume}%",
    "format-muted": "󰝟  静音",
    "format-icons": {
      "headphone": "",
      "headset": "󰋎",
      "phone": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "输出音量：{volume}%\n{desc}"
  },

  "network": {
    "interval": 5,
    "format-wifi": "  {essid} {signalStrength}%",
    "format-ethernet": "󰈀  {ifname}",
    "format-linked": "󰈀  {ifname}",
    "format-disconnected": "󰖪  离线",
    "tooltip-format": "接口：{ifname}\nIP：{ipaddr}/{cidr}\n网关：{gwaddr}",
    "tooltip-format-disconnected": "网络未连接",
    "on-click": "footclient -e nmtui"
  },

  "cpu": {
    "interval": 2,
    "format": "  {usage}%",
    "tooltip-format": "CPU 使用率：{usage}%\n负载：{load}",
    "on-click": "footclient -e htop"
  },

  "memory": {
    "interval": 5,
    "format": "󰍛  {percentage}%",
    "tooltip-format": "内存：{used:0.1f} GiB / {total:0.1f} GiB",
    "on-click": "footclient -e htop"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 8
  },

  "clock": {
    "interval": 1,
    "timezone": "Asia/Shanghai",
    "locale": "zh_CN.UTF-8",
    "format": "  {:%Y-%m-%d %H:%M:%S}",
    "format-alt": "  {:%Y年%m月%d日 %A}",
    "tooltip-format": "<big>{:%Y年%m月}</big>\n<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "weeks-pos": "right",
      "on-scroll": 1,
      "format": {
        "months": "<span color='#c6a0f6'><b>{}</b></span>",
        "days": "<span color='#cad3f5'>{}</span>",
        "weeks": "<span color='#8aadf4'>W{}</span>",
        "weekdays": "<span color='#a6da95'><b>{}</b></span>",
        "today": "<span color='#24273a' background='#c6a0f6'><b><u>{}</u></b></span>"
      }
    }
  }
}
