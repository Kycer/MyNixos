{ config, pkgs, ... }:

let
  tmuxConfig = "${config.xdg.configHome}/tmux/tmux.conf";
in
{
  home = {
    packages = [ pkgs.lazygit ];

    # tmux checks this legacy path before the XDG path used by Home Manager.
    # Forward the legacy path to the configuration generated by Home Manager.
    file.".tmux.conf" = {
      force = true;
      text = ''
        source-file "${tmuxConfig}"
      '';
    };
  };

  programs.tmux = {
    enable = true;
    baseIndex = 1;
    escapeTime = 0;
    focusEvents = true;
    historyLimit = 500000;
    keyMode = "vi";
    mouse = true;
    prefix = "C-g";
    shell = "${pkgs.fish}/bin/fish";
    terminal = "tmux-256color";

    # Home Manager installs the plugin in the Nix store instead of using TPM.
    plugins = [
      {
        plugin = pkgs.tmuxPlugins.tmux-toggle-popup;
        extraConfig = ''
          # Prefix + f: shell popup; prefix + g: lazygit popup
          bind-key f run "#{@popup-toggle} -Ed'##{pane_current_path}' -w75% -h75%"
          bind-key g run "#{@popup-toggle} -Ed'##{pane_current_path}' -w90% -h90% --name=lazygit lazygit"
        '';
      }
    ];

    extraConfig = ''
      # Status bar
      set -g status-position top
      set -g status-interval 5
      set -g status-left-length 50
      set -g status-right-length 80

      set -g status-style "bg=#24273a,fg=#cad3f5"
      set -g status-left " #S "
      set -g status-left-style "fg=#a6da95,bg=#24273a,bold"
      set -g status-right " #{pane_current_command}  %H:%M "
      set -g status-right-style "fg=#a5adcb,bg=#24273a"

      set -g window-status-separator " "
      setw -g window-status-format " #I #W "
      setw -g window-status-style "fg=#8087a2,bg=#24273a"
      setw -g window-status-current-format " #I #W "
      setw -g window-status-current-style "fg=#181926,bg=#c6a0f6,bold"

      set -g pane-border-style "fg=#494d64"
      set -g pane-active-border-style "fg=#c6a0f6"
      set -g pane-border-status off
      set -g mode-style "fg=#181926,bg=#c6a0f6,bold"
      set -g message-style "fg=#cad3f5,bg=#494d64"
      set -g message-command-style "fg=#181926,bg=#8aadf4,bold"

      # Session and terminal behavior
      set -g renumber-windows on
      set -g set-clipboard on
      set -g detach-on-destroy off
      set -g remain-on-exit off
      set -as terminal-features ",xterm-256color:RGB"

      # Copy mode
      bind-key b copy-mode \; \
          send-keys -X start-of-line \; \
          send-keys -X search-backward "@"

      set -g @jump-key "Space"

      bind-key -T copy-mode-vi a send-keys -X cancel
      bind-key -T copy-mode-vi A send-keys -X cancel
      bind-key -T copy-mode-vi Q send-keys -X cancel
      bind-key -T copy-mode-vi S send-keys -X cancel

      bind-key -T copy-mode-vi v send-keys -X begin-selection
      bind-key -T copy-mode-vi C-v send-keys -X rectangle-toggle
      bind-key -T copy-mode-vi y send-keys -X copy-selection-and-cancel
      bind-key -T copy-mode-vi Y \
          send-keys -X begin-selection \; \
          send-keys -X end-of-line \; \
          send-keys -X copy-selection-and-cancel

      bind-key -T copy-mode-vi h send-keys -X cursor-left
      bind-key -T copy-mode-vi j send-keys -X cursor-down
      bind-key -T copy-mode-vi k send-keys -X cursor-up
      bind-key -T copy-mode-vi l send-keys -X cursor-right

      bind-key -T copy-mode-vi U send-keys -N 5 -X cursor-up
      bind-key -T copy-mode-vi E send-keys -N 5 -X cursor-down
      bind-key -T copy-mode-vi W send-keys -N 5 -X next-word-end
      bind-key -T copy-mode-vi B send-keys -N 5 -X previous-word
      bind-key -T copy-mode-vi N send-keys -X start-of-line
      bind-key -T copy-mode-vi I send-keys -X end-of-line
      bind-key -T copy-mode-vi = send-keys -X search-again
      bind-key -T copy-mode-vi - send-keys -X search-reverse

      # Split mode: prefix + s, then h/j/k/l
      bind-key s switch-client -T split-mode
      bind-key -T split-mode h split-window -h -b -c "#{pane_current_path}"
      bind-key -T split-mode j split-window       -c "#{pane_current_path}"
      bind-key -T split-mode k split-window    -b -c "#{pane_current_path}"
      bind-key -T split-mode l split-window -h    -c "#{pane_current_path}"

      # Pane navigation
      bind-key -r h select-pane -L
      bind-key -r j select-pane -D
      bind-key -r k select-pane -U
      bind-key -r l select-pane -R

      # Tab mode: prefix + t, then u/h/l
      bind-key t switch-client -T tab-mode
      bind-key -T tab-mode u new-window -c "#{pane_current_path}"
      bind-key -T tab-mode h previous-window
      bind-key -T tab-mode l next-window

      # Resize panes
      bind-key -r Up resize-pane -U 5
      bind-key -r Down resize-pane -D 5
      bind-key -r Left resize-pane -L 5
      bind-key -r Right resize-pane -R 5

      # Match ~/.tmux.conf; these options take effect when the navigator is loaded.
      set -g @vim-tmux-navigator-left 'h'
      set -g @vim-tmux-navigator-down 'j'
      set -g @vim-tmux-navigator-up 'k'
      set -g @vim-tmux-navigator-right 'l'

      bind-key r source-file "${tmuxConfig}" \; \
          display-message "tmux.conf reloaded"
    '';
  };
}
